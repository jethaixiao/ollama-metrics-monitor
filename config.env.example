# ============================================================
# Ollama Metrics Monitor 配置
# 改完执行: ./start-monitor.sh restart
# ============================================================

# 代理监听端口（DSH / WorkBuddy / 朋友的 API 都填这个端口）
PROXY_PORT=11437

# 上游 Ollama 地址（一般不用改）
OLLAMA_BASE_URL=http://localhost:11434

# SQLite 数据库路径（留空则用脚本同目录 ollama_metrics.db）
# DB_PATH=/absolute/path/ollama_metrics.db

# 日志级别: DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# ---- 公网隧道 ----
# true = 用 ngrok 把面板暴露到公网；false = 仅本机/局域网
TUNNEL_ENABLED=true

# ngrok 固定域名（ngrok 免费账号可申请 1 个）
# 留空 = 每次启动使用随机域名；填 your-name.ngrok-free.app 形式
NGROK_DOMAIN=

# 绑定地址：127.0.0.1 = 仅本机（默认，ngrok 仍可转发）
#           0.0.0.0 = 同时允许局域网访问（注意：局域网内同样没有鉴权）
BIND_HOST=127.0.0.1

# 单个请求体上限（字节），默认 8MB
MAX_BODY_BYTES=8388608

# 访问口令（页面登录 + API Bearer Token）；install.sh 首次会随机生成
# 留空 = 不启用鉴权
ACCESS_CODE=
